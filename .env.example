# Generate a unique local key with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_KEY_ID=current
# When rotating: set a new JWT_SECRET_KEY and JWT_KEY_ID, then temporarily
# add the previous key as JSON: {"previous-key-id":"previous-secret"}
JWT_PREVIOUS_KEYS={}
# Required in production. Local development may leave this blank to use SQLite.
# Example: postgresql://user:password@db-host:5432/taskflow?sslmode=require
DATABASE_URL=
